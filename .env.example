VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Solo para probar el aviso de cookies en local: en localhost no se mide nunca, así que
# con esto en 1 el tag de GA sí se carga tras aceptar y se puede ver en la pestaña Network.
# Nunca en produccion.
VITE_GA_FORZAR_LOCAL=

# Entorno del build: local, pruebas o produccion (sin la variable, produccion). Fuera de produccion
# el sitio entra con correo y contraseña, lleva franja y [LOCAL]/[PRUEBAS] en el título, no mide, y
# VITE_SUPABASE_URL no puede ser la de produccion. Ver CLAUDE.md, «Entornos».
# VITE_ENTORNO=
